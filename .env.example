# ============================================================================
# CleanSpot – Public Toilet Feedback System
# Environment Configuration Template
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' if your build pipeline utilizes flutter_dotenv.
# 2. Update the values with your actual Supabase and Gemini API credentials.
# 3. NEVER commit your actual '.env' file or production API keys to Git!

# ----------------------------------------------------
# Supabase Configuration
# ----------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# ----------------------------------------------------
# Supabase Edge Functions & AI Vision API
# ----------------------------------------------------
# The Gemini Vision API key should be securely set in your Supabase Secrets vault:
# Command: supabase secrets set GEMINI_API_KEY="your-gemini-api-key"
# It is NEVER exposed directly in the mobile client code.
GEMINI_API_KEY=your-google-gemini-api-key-here
